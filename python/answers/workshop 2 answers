"""

Created on Tue Oct 21 14:06:11 2025

 

@author: haf31

"""

import numpy as np

import cv2 as cv

 

img = cv.imread('cacti.jpg')

assert img is not None, "file could not be read, check with os.path.exists()"

img = cv.blur(img,(5,5))

 

b,g,r = cv.split(img)

result = cv.merge((b,g,r))

cimg = cv.cvtColor(result,cv.COLOR_BGR2HSV)

 

green_lower = np.array([30, 10, 10])

green_upper = np.array([140, 200, 200])

 

thresh = cv.inRange(cimg, green_lower,green_upper)

 

count = cv.countNonZero(thresh)

 

circles = cv.HoughCircles(img,cv.HOUGH_GRADIENT,1,30,

                           param1=50,param2=30,minRadius=15,maxRadius=35)

 

circles = np.uint16(np.around(circles))

for i in circles[0,:]:

   # draw the outer circle

   cv.circle(cimg,(i[0],i[1]),i[2],(0,255,0),2)

   # draw the center of the circle

   cv.circle(cimg,(i[0],i[1]),2,(0,0,255),3)

 

cv.imshow('detected circles',cimg)

cv.waitKey(0)

cv.destroyAllWindows()
