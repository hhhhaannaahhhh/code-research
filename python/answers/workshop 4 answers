import cv2 as cv

import time



cv.namedWindow('foreground')

cv.namedWindow('background')

 

cap = cv.VideoCapture("./Sims4Action/GS_S2L1_fC11.mp4")



videoloops = 20 # set your number of loops

videoscale = 1 # scale the video if you want - useful if you use the webcam



# initialise the MoG function

fgbg = cv.createBackgroundSubtractorKNN()



if not cap.isOpened():

  print("Cannot open camera")

  exit(0)

   

# loop through the video the given number of times

while videoloops > 0:

  ret, frame = cap.read()

  # if frame is read correctly ret is True

  if not ret:

    cap.set(cv.CAP_PROP_POS_FRAMES, 0)

    continue



  # apply MoG to the frame to get the mask, and ask it to give you the background image

  fgmask = fgbg.apply(frame)

  bg = fgbg.getBackgroundImage()

   

  # display them all in separate windows so you can see the effect.

  tmp = cv.resize(fgmask, (0,0), fx=videoscale, fy=videoscale)

  cv.imshow('foreground',tmp)

   

  tmp = cv.resize(frame, (0,0), fx=videoscale, fy=videoscale)

  cv.imshow('input',tmp)

   

  tmp = cv.resize(bg, (0,0), fx=videoscale, fy=videoscale)

  cv.imshow('background',tmp)

   

  if cv.waitKey(1) == ord('q'):

    break

   

  # slow the video down a bit

  time.sleep(0.05)   

   

  # if it's the last frame we decrease the number of loops left to run

  if cap.get(cv.CAP_PROP_POS_FRAMES) == cap.get(cv.CAP_PROP_FRAME_COUNT):

    videoloops -= 1



# When everything done, release the capture

cap.release()

cv.destroyAllWindows()



