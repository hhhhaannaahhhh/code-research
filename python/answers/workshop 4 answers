import cv2 as cv 

import os

from sys import exit





cap = cv.VideoCapture("./Sims4Action/Co_S3K1_fC6.mp4")#

   

# if something goes wrong, exit gracefully 

if not cap.isOpened(): 

  print("Cannot open camera")

  exit() 

 

model_file = "graph_opt.pb"

# Check it exists

if not os.path.exists(model_file):

  print(model_file + " does not exist")

  exit()



# Load the model!

net = cv.dnn.readNetFromTensorflow(model_file)



# The required input shape and normalisation for the network

input_shape = (368, 368)

mean = (127.5, 127.5, 127.5)

scale = 1.0

nPoints = 18 # Coco 18 point model

threshold = 0.1





pointPairs = [[16,14],[15,17],[14,0],[15,0],[0,1], # Head and neck

       [2,1],[3,2],[3,4], # right arm

       [1,5],[5,6],[6,7], # left arm

       [1,8],[1,11], # torso

       [8,9],[9,10], # right leg

       [11,12],[12,13] # left leg

       ]

# now open the feed and capture frame-by-frame 

while True: 

  ret, frame = cap.read() # if frame is read OK ret is True

  if not ret:

     print("Can't receive frame (stream end?). Exiting ...")

     break 

 

  frameWidth = frame.shape[1]

  frameHeight = frame.shape[0]

   

  # frame is an image, so we can work with it like any other!

  # we could do some processing here, for now just take as-is

  #image preprocessing

 

  blob = cv.dnn.blobFromImage(frame, scalefactor=scale, 

                size=input_shape, mean=mean, swapRB=True, crop=False)

  net.setInput(blob)

  results = net.forward()

   

  H = results.shape[2]

  W = results.shape[3]

  points = []

  for i in range(nPoints):

    # confidence map of corresponding body's part.

    probMap = results[0, i, :, :]

 

    # Find global maxima of the probMap.

    minVal, prob, minLoc, point = cv.minMaxLoc(probMap)

 

 

    if prob > threshold :

      # Scale the point to fit on the original image

      x = (frameWidth * point[0]) / W

      y = (frameHeight * point[1]) / H

      cv.circle(frame, (int(x), int(y)), 5, (0, 255, 255), thickness=-1, lineType=cv.FILLED)

       

      # Add the point to the list if the probability is greater than the threshold

      points.append((int(x), int(y)))

    else :

      points.append(None)

   

  # Display the joining lines, if both end points detected

  for pair in pointPairs:

    pointA = pair[0]

    pointB = pair[1]

    if points[pointA] and points[pointB]:

      cv.line(frame, points[pointA], points[pointB], (0, 255, 0), 3)

  # Display the resulting frame and detections

  cv.imshow('tracking', frame)

  if cv.waitKey(1) == ord('q'): 

    break 

 

# When everything done, release the capture cap.release() 

cv.destroyAllWindows()
