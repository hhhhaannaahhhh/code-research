#!/usr/bin/env python3

# -*- coding: utf-8 -*-

"""

Created on Tue Nov 7 18:50:35 2023



@author: helenmiles

"""



import numpy as np

import cv2 as cv



cap = cv.VideoCapture("./Sims4Action/Co_S3K1_fC6.mp4")



# get the first frame

ret, frame1 = cap.read()



# we set this up to be the previous frame to compare with

prvs = cv.cvtColor(frame1, cv.COLOR_BGR2GRAY)



# now we set up an array of zeros the same dimensions as the video frame

hsv = np.zeros_like(frame1)



# set the saturation to be full on each pixel by replacing 

# the zeros in the 2nd value of each triplet, i.e. [0, 0, 0] - > [0, 255, 0]

hsv[..., 1] = 255



while(1):

  ret, frame2 = cap.read()

  if not ret:

    print('No frames grabbed!')

    break

   

  # get the next frame so you can compare with the previous

  next = cv.cvtColor(frame2, cv.COLOR_BGR2GRAY)

   

  # calculate the optical flow

  # params: prev, next, flow, pyr_scale, levels, winsize, iterations, poly_n, poly_sigma, flags

  flow = cv.calcOpticalFlowFarneback(prvs, next, None, 0.5, 3, 15, 3, 5, 1.2, 0)

   

  # get the magniture and direction of the resulting vector

  mag, ang = cv.cartToPolar(flow[..., 0], flow[..., 1])

   

  # map the values to the hue and value elements

  hsv[..., 0] = ang*180/np.pi/2

  hsv[..., 2] = cv.normalize(mag, None, 0, 255, cv.NORM_MINMAX)

   

  # convert it back to RGB for display and show the output

  bgr = cv.cvtColor(hsv, cv.COLOR_HSV2BGR)

  img = cv.add(bgr, frame2)

  cv.imshow('frame', img)

   

  k = cv.waitKey(30) & 0xff

  if k == 27:

    break

   

  # set the current frame to be the previous one so we can start again

  prvs = next



cv.destroyAllWindows()



